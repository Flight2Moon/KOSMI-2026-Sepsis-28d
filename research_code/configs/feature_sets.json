{
  "schema_version": "exp123_feature_sets_v1",
  "sets": {
    "FS_FULL": {
      "description": "Professor final-dataset feature contract: exact 57-column order from feature_list.csv.",
      "columns": [
        "age",
        "male",
        "race_white",
        "race_black",
        "race_hispanic",
        "race_asian",
        "race_others",
        "admission_emergency",
        "admission_elective",
        "admission_other",
        "cci",
        "apsiii",
        "gcs_score",
        "bmi",
        "urine_output",
        "crrt",
        "vasopressin",
        "epinephrine",
        "norepinephrine",
        "invasive_mechanical_ventilation",
        "heart_rate_min",
        "heart_rate_max",
        "sbp_min",
        "sbp_max",
        "dbp_min",
        "dbp_max",
        "mbp_min",
        "mbp_max",
        "respiratory_rate_min",
        "respiratory_rate_max",
        "temperature_min",
        "temperature_max",
        "spo2_min",
        "spo2_max",
        "bun_min",
        "bun_max",
        "creatinine_min",
        "creatinine_max",
        "wbc_min",
        "wbc_max",
        "hemoglobin_min",
        "hemoglobin_max",
        "platelet_min",
        "platelet_max",
        "chloride_min",
        "chloride_max",
        "sodium_min",
        "sodium_max",
        "bicarbonate_min",
        "bicarbonate_max",
        "potassium_min",
        "potassium_max",
        "glucose_min",
        "glucose_max",
        "calcium_min",
        "calcium_max",
        "pre_icu_los_d"
      ]
    },
    "FS_NOAPS": {
      "description": "Primary professor protocol feature set: FS_FULL without APS III.",
      "derived_from": "FS_FULL",
      "exclude": [
        "apsiii"
      ]
    },
    "FS_APSONLY": {
      "description": "APS III only reference model.",
      "columns": [
        "apsiii"
      ]
    },
    "FS_LEGACY19": {
      "description": "Historical V7/V8 pre-expansion 19-feature mean-based set; retained only for compatibility/smoke testing.",
      "columns": [
        "gender",
        "age",
        "sofa_score",
        "charlson_comorbidity_index",
        "aps3",
        "heart_rate_mean",
        "sbp_mean",
        "dbp_mean",
        "resp_rate_mean",
        "temperature_mean",
        "hemoglobin_mean",
        "platelets_mean",
        "wbc_mean",
        "bun_mean",
        "creatinine_mean",
        "glucose_mean",
        "chloride_mean",
        "sodium_mean",
        "potassium_mean"
      ]
    },
    "FS_LEGACY18_NOAPS": {
      "description": "Historical 19-feature set without aps3; compatibility/smoke testing only.",
      "derived_from": "FS_LEGACY19",
      "exclude": [
        "aps3"
      ]
    },
    "FS_LEGACY_APSONLY": {
      "description": "Historical aps3-only set; compatibility/smoke testing only.",
      "columns": [
        "aps3"
      ]
    },
    "FS_NOAPS_NO_PREICU": {
      "description": "Robustness sensitivity: primary FS_NOAPS without pre_icu_los_d; sensitivity-only, never primary.",
      "derived_from": "FS_NOAPS",
      "exclude": [
        "pre_icu_los_d"
      ]
    }
  }
}
