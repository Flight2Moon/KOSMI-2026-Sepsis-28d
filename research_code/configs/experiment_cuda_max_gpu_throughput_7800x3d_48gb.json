{
  "project_name": "MIMIC-IV LOS EXP123 Resource-Aware CUDA Baseline",
  "paths": {
    "mimic_csv": "../datasets/dataset_final_260706.csv",
    "eicu_csv": "../datasets/eicu_mimic_schema_complete.csv",
    "runs_dir": "runs"
  },
  "data": {
    "feature_columns": [
      "gender",
      "age",
      "sofa_score",
      "charlson_comorbidity_index",
      "aps3",
      "heart_rate_mean",
      "sbp_mean",
      "dbp_mean",
      "resp_rate_mean",
      "temperature_mean",
      "hemoglobin_mean",
      "platelets_mean",
      "wbc_mean",
      "bun_mean",
      "creatinine_mean",
      "glucose_mean",
      "chloride_mean",
      "sodium_mean",
      "potassium_mean"
    ],
    "target_column": "LOS",
    "identifier_columns": [
      "subject_id",
      "hadm_id",
      "stay_id"
    ],
    "patient_id_column": "subject_id",
    "threshold_days": [
      7,
      14,
      28
    ]
  },
  "split": {
    "train_ratio": 0.7,
    "validation_ratio": 0.15,
    "test_ratio": 0.15,
    "seed": 42,
    "max_attempts": 100
  },
  "models": {
    "decision_tree": {
      "enabled": true,
      "parameters": {
        "max_depth": 5,
        "min_samples_split": 10,
        "class_weight": "balanced"
      }
    },
    "logistic_regression": {
      "enabled": true,
      "epochs": 100,
      "batch_size": 64,
      "learning_rate": 0.001,
      "metric_interval": 5,
      "device": "auto"
    },
    "random_forest": {
      "enabled": true,
      "parameters": {
        "n_estimators": 100,
        "max_depth": 10,
        "n_jobs": 1,
        "class_weight": "balanced"
      }
    },
    "svm": {
      "enabled": true,
      "parameters": {
        "kernel": "rbf",
        "C": 1.0,
        "gamma": "scale",
        "probability": true,
        "class_weight": "balanced",
        "cache_size": 2048
      }
    },
    "xgboost": {
      "enabled": true,
      "parameters": {
        "n_estimators": 100,
        "max_depth": 6,
        "learning_rate": 0.1,
        "objective": "binary:logistic",
        "eval_metric": "logloss",
        "tree_method": "hist",
        "device": "cpu",
        "n_jobs": 1,
        "verbosity": 1
      }
    }
  },
  "evaluation": {
    "default_decision_threshold": 0.5,
    "calibration_bins": 10,
    "external_bootstrap_repeats": 500,
    "save_plots": true,
    "multiclass_bootstrap_repeats": 500,
    "bootstrap_confidence_level": 0.95,
    "binary_bootstrap_repeats": 500
  },
  "explainability": {
    "enabled": true,
    "sample_size": 100,
    "background_size": 50,
    "kernel_nsamples": 100
  },
  "execution": {
    "stop_on_error": false
  },
  "audit": {
    "enabled": true,
    "strict_non_missing_columns": [],
    "fail_on_strict_missing": false,
    "eicu_harmonizer_provenance": {
      "enabled": false,
      "path": null,
      "required": false,
      "auto_discovery": false,
      "imputed_feature_denominator": 18
    }
  },
  "outcomes": {
    "mortality_column": "hospital_expire_flag",
    "los_column": "LOS",
    "landmark_days": 28,
    "los_derivation": {
      "enabled": true,
      "datasets": [
        "mimic",
        "eicu"
      ],
      "admission_time_column": "admittime",
      "discharge_time_column": "dischtime",
      "in_hospital_death_time_column": "dischtime",
      "overwrite_existing_los": true,
      "allow_existing_los_fallback": false,
      "discrepancy_tolerance_days": 0.05,
      "fail_on_discrepancy": false,
      "round_decimals": 6
    }
  },
  "experiments": {
    "exp1_flat_3class": {
      "enabled": true,
      "models": [
        "decision_tree",
        "logistic_regression",
        "random_forest",
        "svm",
        "xgboost"
      ],
      "representative_metric": "macro_auroc"
    },
    "exp2_two_stage": {
      "enabled": true,
      "stage1_mortality": {
        "models": [
          "decision_tree",
          "logistic_regression",
          "random_forest",
          "svm",
          "xgboost"
        ],
        "reference_metric": "auprc"
      },
      "stage2_long_stay": {
        "models": [
          "decision_tree",
          "logistic_regression",
          "random_forest",
          "svm",
          "xgboost"
        ],
        "reference_metric": "auroc"
      }
    },
    "exp3_survivor_binary": {
      "enabled": true,
      "reuse_stage2_artifacts": true
    }
  },
  "super_learner": {
    "library_members": [
      "xgboost",
      "logistic_regression"
    ],
    "meta_learner_method": "nnls",
    "fit_split": "validation_meta",
    "threshold_selection_split": "validation_threshold",
    "validation_subsplit_method": "stratified_group_2fold",
    "seed": 42,
    "auroc_margin_guard": 0.02,
    "practical_tie_margin": 0.005,
    "bootstrap_repeats": 500,
    "candidate_source": "stage_heterogeneity_validation_frozen"
  },
  "optimization": {
    "enabled": true,
    "seed": 42,
    "cv_folds": 5,
    "top_k_for_validation": 3,
    "search_stages": {
      "smoke": {
        "trials": 5,
        "cv_folds": 2
      },
      "coarse": {
        "trials": 50,
        "cv_folds": 5
      },
      "fine": {
        "trials": 30,
        "cv_folds": 5
      }
    },
    "selection": {
      "stability_penalty": 0.5,
      "practical_tie_margin": 0.005,
      "auroc_margin_guard": 0.02,
      "prefer_simpler_model_on_tie": true,
      "overfit_penalty": 0.5
    },
    "runtime_limits": {
      "trial_timeout_seconds": 3600,
      "study_timeout_seconds": 86400,
      "timeout_mode": "soft_record_only"
    },
    "resume": true
  },
  "optimization_objectives": {
    "exp1_flat_3class": {
      "primary": "macro_auroc",
      "direction": "maximize",
      "secondary": "multiclass_brier",
      "secondary_direction": "minimize"
    },
    "stage1_mortality": {
      "primary": "auprc",
      "direction": "maximize",
      "secondary": "brier_score",
      "secondary_direction": "minimize"
    },
    "stage2_long_stay": {
      "primary": "auroc",
      "direction": "maximize",
      "secondary": "brier_score",
      "secondary_direction": "minimize"
    }
  },
  "heterogeneity": {
    "subgroup_variables": [
      "age",
      "sofa_score",
      "aps3",
      "charlson_comorbidity_index"
    ],
    "n_bins": 3,
    "minimum_bin_size": 30,
    "minimum_class_count": 10,
    "auroc_margin_guard": 0.02,
    "fdr_method": "fdr_bh",
    "default_probability_threshold": 0.5,
    "fdr_alpha": 0.05,
    "brier_tie_margin": 0.005,
    "trend_bins": 50
  },
  "development": {
    "completed_steps": [
      "outcomes",
      "common_three_class_splits",
      "shared_training_engine",
      "optimization_engine",
      "exp1_flat_multiclass",
      "stage1_mortality",
      "stage2_long_stay_and_exp3",
      "stage_heterogeneity",
      "super_learner",
      "oracle_pipeline",
      "final_statistical_comparison",
      "final_freeze"
    ],
    "current_step": "final_freeze_with_data_quality_hotfix",
    "model_training_enabled": true,
    "next_required_step": "release_freeze_and_preflight",
    "quality_controls": [
      "audited_outcome_row_exclusion"
    ]
  },
  "oracle_pipeline": {
    "bootstrap_repeats": 500,
    "seed": 42,
    "probability_restoration": "conditional_product",
    "hard_decision_rule": "stage1_threshold_then_stage2_threshold",
    "confirmatory_splits": [
      "internal_test",
      "external_eicu"
    ],
    "allow_overwrite": false
  },
  "final_comparison": {
    "bootstrap_repeats": 500,
    "confidence_level": 0.95,
    "seed": 42,
    "minimum_successful_bootstrap_repeats": 100,
    "comparison_metrics": [
      "macro_auroc",
      "macro_auprc",
      "macro_f1",
      "balanced_accuracy",
      "multiclass_brier",
      "multiclass_log_loss"
    ],
    "delong_scope": "class_specific_ovr",
    "mcnemar_scope": "overall_correctness",
    "fdr_method": "fdr_bh",
    "fdr_alpha": 0.05,
    "fdr_family": "per_confirmatory_split",
    "allow_overwrite": false
  },
  "final_freeze": {
    "release_directory": "exp123_release_freeze",
    "requirements_policy": "exact_pins_required",
    "environment_verification": "strict_direct_dependencies_and_python",
    "minimum_free_disk_gb": 5.0,
    "dataset_sha256_preflight": true,
    "confirmatory_design_freeze_required": true,
    "confirmatory_order_locked": true,
    "confirmatory_overwrite_allowed": false,
    "final_run_freeze_required": true
  },
  "data_quality": {
    "outcome_row_exclusion": {
      "enabled": true,
      "datasets": [
        "mimic",
        "eicu"
      ],
      "rules": {
        "negative_los": true,
        "missing_los": false,
        "missing_mortality": false,
        "invalid_mortality": false
      },
      "max_excluded_fraction": 0.01,
      "max_excluded_rows": 100,
      "fail_if_limit_exceeded": true,
      "rationale": "Exclude only logically impossible negative hospital LOS rows while preserving source-row traceability and full audit outputs."
    }
  },
  "progress": {
    "enabled": true,
    "tqdm": true,
    "refresh_seconds": 0.5,
    "structured_log": true,
    "gpu_monitor_interval_seconds": 2.0,
    "show_completed_operations": true
  },
  "hardware": {
    "profile_name": "dual_rtx5060ti_16gb_ryzen7800x3d_48gb_gpu_dense_v3",
    "cpu": {
      "threads_per_worker": 2
    },
    "cuda": {
      "mode": "required",
      "required": true,
      "gpu_ids": [
        0,
        1
      ],
      "pytorch": true,
      "xgboost": true,
      "pin_memory": true,
      "non_blocking": true,
      "data_loader_workers": 2,
      "persistent_workers": true,
      "mixed_precision": false,
      "allow_tf32": false,
      "deterministic": true
    },
    "multi_gpu": {
      "strategy": "task_parallel",
      "enabled": true,
      "max_parallel_tasks": 6
    },
    "accelerator": {
      "backend": "cuda"
    }
  },
  "resources": {
    "accelerator": {
      "backend": "cuda",
      "required": true
    },
    "scheduler": {
      "enabled": true,
      "mode": "resource_aware",
      "max_concurrent_jobs": 9,
      "poll_interval_seconds": 1.0,
      "resource_refresh_seconds": 1.0,
      "failure_policy": "stop_dependents_continue_independent",
      "max_resource_wait_seconds": 0
    },
    "cpu": {
      "total_thread_limit": 15,
      "reserve_threads": 2,
      "default_threads_per_job": 2,
      "max_threads_per_job": 6
    },
    "memory": {
      "total_limit_gb": 56.0,
      "reserve_gb": 4.0,
      "max_fraction": 0.9,
      "minimum_free_gb_to_launch": 4.0,
      "breach_grace_seconds": 120,
      "enforce_job_ram_limit": true
    },
    "cuda": {
      "gpu_ids": [
        0,
        1
      ],
      "max_jobs_per_gpu": 3,
      "minimum_free_memory_gb": 1.0,
      "reserve_memory_gb": 1.0,
      "pytorch_memory_fraction": 0.24,
      "assignment_strategy": "most_free_memory",
      "allow_cpu_fallback": false,
      "enforce_process_memory_limit": true,
      "gpu_memory_breach_grace_seconds": 120,
      "enforce_exclusive_gpu": true
    },
    "mps": {
      "enabled": false,
      "max_concurrent_jobs": 1,
      "pytorch_memory_fraction": 0.0,
      "minimum_free_unified_memory_gb": 0,
      "allow_cpu_fallback": false,
      "enforce_unified_memory_limit": false
    },
    "job_resources": {
      "decision_tree": {
        "cpu_threads": 1,
        "ram_gb": 4.0
      },
      "logistic_regression": {
        "cpu_threads": 2,
        "ram_gb": 7.0,
        "gpu_memory_gb": 0.0,
        "exclusive_gpu": false,
        "accelerator": "cpu"
      },
      "random_forest": {
        "cpu_threads": 4,
        "ram_gb": 9.0
      },
      "svm": {
        "cpu_threads": 1,
        "ram_gb": 12.0
      },
      "xgboost": {
        "cpu_threads": 2,
        "ram_gb": 10.0,
        "gpu_memory_gb": 6.0,
        "exclusive_gpu": false
      },
      "outcomes": {
        "cpu_threads": 2,
        "ram_gb": 6.0
      },
      "splits": {
        "cpu_threads": 2,
        "ram_gb": 6.0
      },
      "finalize": {
        "cpu_threads": 2,
        "ram_gb": 5.0
      },
      "heterogeneity": {
        "cpu_threads": 3,
        "ram_gb": 8.0
      },
      "super_learner": {
        "cpu_threads": 3,
        "ram_gb": 8.0
      },
      "confirmatory_inference": {
        "cpu_threads": 2,
        "ram_gb": 8.0,
        "accelerator": "cuda",
        "gpu_memory_gb": 6.0,
        "exclusive_gpu": false
      },
      "final_comparison": {
        "cpu_threads": 4,
        "ram_gb": 12.0,
        "accelerator": "cpu",
        "gpu_memory_gb": 0.0,
        "exclusive_gpu": false
      }
    },
    "resource_failure_policy": {
      "auto_retry": true,
      "max_retries": 4,
      "retry_cpu_thread_scale": 0.75,
      "retry_batch_size_scale": 0.65,
      "retry_exclusive_gpu": true,
      "retry_ram_scale": 1.5,
      "retry_gpu_memory_scale": 1.25,
      "retry_unified_memory_scale": 1.35,
      "serialize_after_resource_retry_level": 2,
      "max_ram_gb_per_job": 48.0,
      "max_gpu_memory_gb_per_job": 14.0,
      "max_unified_memory_gb_per_job": 0.0
    }
  },
  "artifact_integrity": {
    "probability_tolerance": {
      "cpu": {
        "atol": 1e-07,
        "rtol": 0.0
      },
      "cuda": {
        "atol": 1e-06,
        "rtol": 1e-06
      },
      "mps": {
        "atol": 1e-06,
        "rtol": 1e-06
      }
    },
    "require_decision_equality": true,
    "maximum_decision_mismatches": 0
  },
  "dashboard": {
    "host": "127.0.0.1",
    "port": 8080,
    "refresh_seconds": 2,
    "enable_sse": true,
    "token_required_for_non_localhost": true,
    "history_points": 300,
    "max_log_lines": 2000
  },
  "metadata": {
    "recommended_entrypoint": "bash run_exp123_cuda_dense.sh --refreeze",
    "scheduler_schema": "v3_reservation_aware"
  },
  "external_validation": {
    "mortality_guard": {
      "enabled": true,
      "block_confirmatory_on_failure": true,
      "minimum_death_count": 10,
      "minimum_death_rate": 0.001,
      "maximum_death_rate": 0.5,
      "fail_on_missing": false,
      "chunksize": 250000,
      "status_if_failed": "external_mortality_confirmatory_on_hold"
    }
  }
}
