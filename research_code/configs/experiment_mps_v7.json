{
  "project_name": "MIMIC-IV EXP123 V7.2 M1 Max Cohort-First Three-Track",
  "paths": {
    "mimic_csv": "../datasets/dataset_final_260706.csv",
    "eicu_csv": "../datasets/eicu_mimic_schema_complete.csv",
    "runs_dir": "runs"
  },
  "data": {
    "feature_columns": [
      "gender",
      "age",
      "sofa_score",
      "charlson_comorbidity_index",
      "aps3",
      "heart_rate_mean",
      "sbp_mean",
      "dbp_mean",
      "resp_rate_mean",
      "temperature_mean",
      "hemoglobin_mean",
      "platelets_mean",
      "wbc_mean",
      "bun_mean",
      "creatinine_mean",
      "glucose_mean",
      "chloride_mean",
      "sodium_mean",
      "potassium_mean"
    ],
    "target_column": "LOS",
    "identifier_columns": [
      "subject_id",
      "hadm_id",
      "stay_id"
    ],
    "patient_id_column": "subject_id",
    "threshold_days": [
      7,
      14,
      28
    ]
  },
  "split": {
    "train_ratio": 0.7,
    "validation_ratio": 0.15,
    "test_ratio": 0.15,
    "seed": 42,
    "max_attempts": 100
  },
  "models": {
    "decision_tree": {
      "enabled": true,
      "parameters": {
        "max_depth": 5,
        "min_samples_split": 10
      },
      "training_policy": {
        "class_weight_mode": "none"
      }
    },
    "logistic_regression": {
      "enabled": true,
      "implementation": "sklearn",
      "parameters": {
        "solver": "saga",
        "C": 1.0,
        "max_iter": 5000,
        "tol": 1e-05,
        "fit_intercept": true,
        "l1_ratio": 0.0
      },
      "training_policy": {
        "class_weight_mode": "none"
      },
      "device": "cpu"
    },
    "random_forest": {
      "enabled": true,
      "parameters": {
        "n_estimators": 100,
        "max_depth": 10,
        "n_jobs": 1
      },
      "training_policy": {
        "class_weight_mode": "none"
      }
    },
    "svm": {
      "enabled": true,
      "parameters": {
        "kernel": "rbf",
        "C": 1.0,
        "gamma": "scale",
        "probability": true,
        "cache_size": 2048
      },
      "training_policy": {
        "class_weight_mode": "none"
      }
    },
    "xgboost": {
      "enabled": true,
      "parameters": {
        "n_estimators": 100,
        "max_depth": 6,
        "learning_rate": 0.1,
        "objective": "binary:logistic",
        "eval_metric": "logloss",
        "tree_method": "hist",
        "device": "cpu",
        "n_jobs": 1,
        "verbosity": 1
      },
      "training_policy": {
        "class_weight_mode": "none"
      }
    }
  },
  "evaluation": {
    "default_decision_threshold": 0.5,
    "calibration_bins": 10,
    "external_bootstrap_repeats": 500,
    "save_plots": true,
    "multiclass_bootstrap_repeats": 500,
    "bootstrap_confidence_level": 0.95,
    "binary_bootstrap_repeats": 500
  },
  "explainability": {
    "enabled": true,
    "sample_size": 100,
    "background_size": 50,
    "kernel_nsamples": 100
  },
  "execution": {
    "stop_on_error": false
  },
  "audit": {
    "enabled": true,
    "strict_non_missing_columns": [],
    "fail_on_strict_missing": false,
    "eicu_harmonizer_provenance": {
      "enabled": false,
      "path": null,
      "required": false,
      "auto_discovery": false,
      "imputed_feature_denominator": 18
    }
  },
  "outcomes": {
    "mortality_column": "hospital_expire_flag",
    "los_column": "LOS",
    "landmark_days": 28,
    "los_derivation": {
      "enabled": true,
      "datasets": [
        "mimic",
        "eicu"
      ],
      "admission_time_column": "icu_intime",
      "discharge_time_column": "dischtime",
      "in_hospital_death_time_column": "dischtime",
      "overwrite_existing_los": true,
      "allow_existing_los_fallback": false,
      "discrepancy_tolerance_days": 0.05,
      "fail_on_discrepancy": false,
      "round_decimals": 6
    }
  },
  "experiments": {
    "exp1_flat_3class": {
      "enabled": true,
      "models": [
        "decision_tree",
        "logistic_regression",
        "random_forest",
        "svm",
        "xgboost"
      ],
      "representative_metric": "macro_auroc"
    },
    "exp2_two_stage": {
      "enabled": true,
      "stage1_mortality": {
        "models": [
          "decision_tree",
          "logistic_regression",
          "random_forest",
          "svm",
          "xgboost"
        ],
        "reference_metric": "auprc"
      },
      "stage2_long_stay": {
        "models": [
          "decision_tree",
          "logistic_regression",
          "random_forest",
          "svm",
          "xgboost"
        ],
        "reference_metric": "auroc"
      }
    },
    "exp3_survivor_binary": {
      "enabled": true,
      "reuse_stage2_artifacts": true,
      "note": "EXP3 continues to reference Stage2 oracle A/C artifacts in this release; no duplicate training."
    }
  },
  "super_learner": {
    "library_members": [
      "xgboost",
      "logistic_regression"
    ],
    "meta_learner_method": "nnls",
    "fit_split": "validation_meta",
    "threshold_selection_split": "validation_threshold",
    "validation_subsplit_method": "stratified_group_2fold",
    "seed": 42,
    "auroc_margin_guard": 0.02,
    "practical_tie_margin": 0.005,
    "bootstrap_repeats": 500,
    "candidate_source": "stage_heterogeneity_validation_frozen"
  },
  "optimization": {
    "enabled": true,
    "seed": 42,
    "cv_folds": 5,
    "top_k_for_validation": 3,
    "search_stages": {
      "smoke": {
        "trials": 5,
        "cv_folds": 2
      },
      "coarse": {
        "trials": 50,
        "cv_folds": 5
      },
      "fine": {
        "trials": 30,
        "cv_folds": 5
      }
    },
    "selection": {
      "stability_penalty": 0.5,
      "practical_tie_margin": 0.005,
      "auroc_margin_guard": 0.02,
      "prefer_simpler_model_on_tie": true,
      "overfit_penalty": 0.5
    },
    "runtime_limits": {
      "trial_timeout_seconds": 3600,
      "study_timeout_seconds": 86400,
      "timeout_mode": "soft_record_only"
    },
    "resume": true,
    "model_search_budgets": {
      "decision_tree": {
        "coarse": {
          "trials": 24,
          "cv_folds": 5
        },
        "fine": {
          "trials": 14,
          "cv_folds": 5
        }
      },
      "logistic_regression": {
        "coarse": {
          "trials": 16,
          "cv_folds": 5
        },
        "fine": {
          "trials": 10,
          "cv_folds": 5
        }
      },
      "random_forest": {
        "coarse": {
          "trials": 24,
          "cv_folds": 5
        },
        "fine": {
          "trials": 14,
          "cv_folds": 5
        }
      },
      "svm": {
        "coarse": {
          "trials": 10,
          "cv_folds": 5
        },
        "fine": {
          "trials": 6,
          "cv_folds": 5
        }
      },
      "xgboost": {
        "coarse": {
          "trials": 30,
          "cv_folds": 5
        },
        "fine": {
          "trials": 18,
          "cv_folds": 5
        }
      }
    },
    "task_model_search_budgets": {
      "stage1_mortality": {
        "logistic_regression": {
          "coarse": {
            "trials": 20,
            "cv_folds": 5
          },
          "fine": {
            "trials": 12,
            "cv_folds": 5
          }
        },
        "xgboost": {
          "coarse": {
            "trials": 36,
            "cv_folds": 5
          },
          "fine": {
            "trials": 20,
            "cv_folds": 5
          }
        }
      }
    }
  },
  "optimization_objectives": {
    "exp1_flat_3class": {
      "primary": "macro_auprc",
      "direction": "maximize",
      "secondary": "multiclass_brier",
      "secondary_direction": "minimize"
    },
    "stage1_mortality": {
      "primary": "auprc",
      "direction": "maximize",
      "secondary": "brier_score",
      "secondary_direction": "minimize"
    },
    "stage2_long_stay": {
      "primary": "auprc",
      "direction": "maximize",
      "secondary": "brier_score",
      "secondary_direction": "minimize"
    }
  },
  "heterogeneity": {
    "subgroup_variables": [
      "age",
      "sofa_score",
      "aps3",
      "charlson_comorbidity_index"
    ],
    "n_bins": 3,
    "minimum_bin_size": 30,
    "minimum_class_count": 10,
    "auroc_margin_guard": 0.02,
    "fdr_method": "fdr_bh",
    "default_probability_threshold": 0.5,
    "fdr_alpha": 0.05,
    "brier_tie_margin": 0.005,
    "trend_bins": 50
  },
  "development": {
    "completed_steps": [
      "outcomes",
      "common_three_class_splits",
