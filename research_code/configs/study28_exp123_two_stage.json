{
  "schema_version": "study28_exp123_two_stage_v1",
  "study_id": "sepsis3_28d_exp123_multimodel_external",
  "feature_set": "FS_NOAPS",
  "seed": 2026,
  "baseline": {
    "validation_fraction": 0.20,
    "models": [
      "logistic_regression",
      "decision_tree",
      "random_forest",
      "xgboost",
      "lightgbm"
    ],
    "optional_models": ["svm"],
    "selection": {
      "exp1": "macro_auroc",
      "stage1": "auprc",
      "stage2": "auprc",
      "exp2_pair": "macro_auroc"
    }
  },
  "optimization": {
    "cv_folds": 5,
    "trial_budgets": {
      "logistic_regression": 30,
      "decision_tree": 40,
      "random_forest": 40,
      "xgboost": 50,
      "lightgbm": 50,
      "svm": 20
    },
    "majority_downsampling": {
      "enabled": true,
      "max_majority_to_minority_ratio": 2.0,
      "note": "Training-fold only. Validation, temporal and external distributions are never resampled."
    },
    "external_validation_for_all_optimized_candidates": true
  },
  "models": {
    "logistic_regression": {
      "implementation": "sklearn",
      "parameters": {
        "solver": "lbfgs",
        "C": 1.0,
        "max_iter": 2000,
        "tol": 1e-6,
        "fit_intercept": true
      }
    },
    "decision_tree": {
      "parameters": {
        "max_depth": 5,
        "min_samples_split": 10,
        "min_samples_leaf": 2
      }
    },
    "random_forest": {
      "parameters": {
        "n_estimators": 200,
        "max_depth": 10,
        "min_samples_split": 4,
        "min_samples_leaf": 2,
        "max_features": "sqrt"
      }
    },
    "xgboost": {
      "parameters": {
        "n_estimators": 300,
        "max_depth": 6,
        "learning_rate": 0.05,
        "subsample": 0.9,
        "colsample_bytree": 0.9,
        "tree_method": "hist",
        "device": "cpu",
        "verbosity": 0
      }
    },
    "lightgbm": {
      "parameters": {
        "n_estimators": 200,
        "num_leaves": 15,
        "learning_rate": 0.05,
        "min_child_samples": 50,
        "verbose": -1
      }
    },
    "svm": {
      "parameters": {
        "kernel": "rbf",
        "C": 1.0,
        "gamma": "scale",
        "probability": true,
        "cache_size": 4096,
        "max_iter": 2000000,
        "tol": 0.001
      }
    }
  },
  "reporting": {
    "required_external_sites": ["eicu_alt", "eicu_primary", "sicdb", "nwicu"],
    "baseline_ready_marker": "BASELINE_RESULTS_READY.json",
    "optimization_complete_marker": "OPTIMIZATION_RESULTS_COMPLETE.json"
  }
}
