{
  "project_name": "Smoke Test",
  "paths": {
    "mimic_csv": "tests/generated/mimic.csv",
    "eicu_csv": "tests/generated/eicu.csv.gz",
    "runs_dir": "tests/generated/runs"
  },
  "data": {
    "feature_columns": [
      "gender",
      "age",
      "sofa_score",
      "charlson_comorbidity_index",
      "aps3",
      "heart_rate_mean",
      "sbp_mean",
      "dbp_mean",
      "resp_rate_mean",
      "temperature_mean",
      "hemoglobin_mean",
      "platelets_mean",
      "wbc_mean",
      "bun_mean",
      "creatinine_mean",
      "glucose_mean",
      "chloride_mean",
      "sodium_mean",
      "potassium_mean"
    ],
    "target_column": "LOS",
    "identifier_columns": [
      "subject_id",
      "hadm_id",
      "stay_id"
    ],
    "patient_id_column": "subject_id",
    "threshold_days": [
      7,
      14,
      28
    ]
  },
  "split": {
    "train_ratio": 0.7,
    "validation_ratio": 0.15,
    "test_ratio": 0.15,
    "seed": 42,
    "max_attempts": 20
  },
  "models": {
    "decision_tree": {
      "enabled": true,
      "parameters": {
        "max_depth": 3
      }
    },
    "logistic_regression": {
      "enabled": true,
      "epochs": 3,
      "batch_size": 64,
      "learning_rate": 0.001,
      "metric_interval": 1,
      "device": "cpu"
    },
    "random_forest": {
      "enabled": true,
      "parameters": {
        "n_estimators": 10,
        "max_depth": 4,
        "n_jobs": 1
      }
    },
    "svm": {
      "enabled": true,
      "parameters": {
        "kernel": "rbf",
        "C": 1.0,
        "gamma": "scale",
        "probability": true,
        "cache_size": 256
      }
    },
    "xgboost": {
      "enabled": true,
      "parameters": {
        "n_estimators": 10,
        "max_depth": 3,
        "learning_rate": 0.1,
        "tree_method": "hist",
        "device": "cpu",
        "n_jobs": 1,
        "eval_metric": "logloss"
      }
    }
  },
  "evaluation": {
    "default_decision_threshold": 0.5,
    "calibration_bins": 5,
    "external_bootstrap_repeats": 2,
    "save_plots": false
  },
  "explainability": {
    "enabled": false,
    "sample_size": 10,
    "background_size": 10,
    "kernel_nsamples": 20
  },
  "execution": {
    "stop_on_error": true
  },
  "audit": {
    "enabled": true,
    "strict_non_missing_columns": [],
    "fail_on_strict_missing": false,
    "eicu_harmonizer_provenance": {
      "enabled": false,
      "path": null,
      "required": false,
      "auto_discovery": false,
      "imputed_feature_denominator": 18
    }
  }
}
